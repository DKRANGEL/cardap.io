# --- CLIENTE (seguro expor no browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Passo do código de 6 dígitos na tela de acesso (/entrar). Deixe false até o projeto
# ter SMTP próprio e os templates de e-mail com {{ .Token }} (veja supabase/templates).
# Sem isso o e-mail só traz o link, e ligar a flag deixaria o lojista sem código.
NEXT_PUBLIC_CODIGO_HABILITADO=false
