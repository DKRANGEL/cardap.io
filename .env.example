# --- CLIENTE (seguro expor no browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVIDOR (nunca expor no browser, nunca commitar) ---
# Chave de serviço: cria usuários e redefine senhas na área /admin. Ignora a RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Usadas só pelo script `pnpm seed:admin`, que cria o admin inicial.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chave que cifra as senhas dos clientes guardadas para o admin consultar (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se for perdida, as senhas guardadas ficam ilegiveis (o admin redefine as senhas).
SENHAS_CHAVE=
